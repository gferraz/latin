doctype html
html
  head
    meta charset="utf-8"
    title Lingua Latina
    css:
      table {
        border-collapse: collapse;
        margin: 25px 0;
        font-size: 0.9em;
        min-width: 400px;
      }
      td {
        padding: 4px;
        border: 1px solid;
      }
      th {
        padding: 4px;
        border: 1px solid;
        min-width: 2em;
      }
      tr.genitivus td {
        color: blue;
      }
      .notae {
        margin-top: 20px;
      }
      .notae ol {
        padding-left: 20px;
      }
      .notae li {
        margin: 4px 0;
      }
  body
    h1 Declinationes
    - columns = DECLINATIONES.size * GENERA.size
    - NUMERI.each do |numerus|
        table
          thead
              tr
                th colspan="#{columns + 1}" = numerus.capitalize
              tr
                th
                - DECLINATIONES.each do |declinatio|
                  th colspan=3 = declinatio
              tr
                th Casus
                - DECLINATIONES.each do |declinatio|
                  - GENERA.each do |genus|
                    th= genus
          tbody
            - CASUS.each do |casus|
              tr class="#{casus}"
                th= casus.capitalize
                - DECLINATIONES.each do |declinatio|
                  - desinientiae = (DESINENTIAE.dig(casus, numerus, declinatio) || {}).transform_values { |v| v.join(" / -") }
                  - if desinientiae.empty?
                    td colspan=3
                    - next
                  - if desinientiae[:mf]
                    - if desinientiae[:mf] == desinientiae[:n]
                      td colspan=3 = "-" + desinientiae[:mf]
                      - next
                    - else
                      td colspan=2 = "-" + desinientiae[:mf]
                  - elsif desinientiae[:f]
                    td
                    td= "-" + desinientiae[:f]
                  - else
                    td colspan=2
                  - if desinientiae[:n]
                    td= "-#{desinientiae[:n]}"
                  - else
                    td
  - unless EXCEPTIONES.empty?
    .notae
      ol
        - EXCEPTIONES.each do |nota|
          li= nota
