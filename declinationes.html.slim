doctype html
html lang="la"
  head
    meta charset="utf-8"
    title Dēclīnātiōnēs Latīnae
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap"
    css:
      :root {
        --ink: #2a2118;
        --parchment: #faf6ee;
        --rule: #d3c8b2;
        --accent: #8a2b1e;
        --zebra: #f3ede1;
        --gold: #ac863d;
        --lapis: #314d70;
      }
      * {
        box-sizing: border-box;
      }
      body {
        max-width: 62rem;
        margin: 0 auto;
        padding: 3rem 2rem 4rem;
        background: var(--parchment);
        color: var(--ink);
        font-family: "Cardo", Georgia, "Times New Roman", serif;
        font-size: 1.05rem;
        line-height: 1.45;
      }
      h1 {
        margin: 0;
        text-align: center;
        font-family: "Cardo", Georgia, serif;
        font-weight: 400;
        font-variant: small-caps;
        letter-spacing: 0.1em;
        font-size: 2.1rem;
      }
      .frontispiece {
        position: relative;
        padding: 1rem 7rem 0.5rem;
      }
      .initial {
        display: inline-block;
        margin-right: 0.08em;
        padding: 0.02em 0.13em;
        border: 3px double var(--gold);
        outline: 1px solid var(--accent);
        outline-offset: 3px;
        background: #eee2c5;
        color: var(--accent);
        font-size: 1.65em;
        line-height: 1;
        text-shadow: 1px 1px var(--gold);
        vertical-align: -0.08em;
      }
      .vine {
        position: absolute;
        top: 0;
        left: 0;
        width: 7rem;
        height: 9rem;
        overflow: visible;
        pointer-events: none;
      }
      .vine-right {
        right: 0;
        left: auto;
        transform: scaleX(-1);
      }
      .vine .stem {
        fill: none;
        stroke: var(--gold);
        stroke-width: 1.5;
        stroke-linecap: round;
      }
      .vine .leaf {
        fill: var(--lapis);
        stroke: var(--gold);
        stroke-width: 0.8;
      }
      .vine .leaf-red { fill: var(--accent); }
      .vine .berry { fill: var(--gold); }
      @media (max-width: 700px) {
        .frontispiece { padding: 1rem 2.5rem 0.5rem; }
        h1 { font-size: 1.65rem; }
        .vine { width: 3rem; height: 5rem; }
      }
      h1::after {
        content: "";
        display: block;
        width: 8rem;
        margin: 0.6rem auto 0;
        border-bottom: 1px solid var(--rule);
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 2.5rem 0;
        font-size: 0.95rem;
      }
      caption {
        font-variant: small-caps;
        letter-spacing: 0.18em;
        font-size: 1.3rem;
        padding-bottom: 0.6rem;
      }
      th,
      td {
        padding: 0.4em 0.55em;
        text-align: left;
        vertical-align: baseline;
      }
      thead th {
        border-bottom: 2px solid var(--ink);
        font-weight: 700;
      }
      thead tr:first-child th {
        border-bottom: 1px solid var(--rule);
      }
      thead tr:nth-child(2) th:not(:first-child) {
        font-style: italic;
        font-weight: 400;
      }
      tbody th {
        text-align: left;
        font-variant: small-caps;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }
      tbody th,
      tbody td {
        border-bottom: 1px solid var(--rule);
      }
      tbody tr:nth-child(even) {
        background: var(--zebra);
      }
      tbody tr:hover {
        background: #e9dfcb;
      }
      .sep {
        border-left: 1px solid var(--rule);
      }
      tbody td {
        border-left: 1px solid var(--rule);
      }
      tr.genitivus {
        background: #f6ebe2;
      }
      tr.genitivus th,
      tr.genitivus td {
        color: var(--accent);
        font-weight: 700;
      }
      .notae {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-size: 0.92rem;
      }
      .notae ol {
        margin: 0;
        padding-left: 1.4rem;
      }
      .notae li {
        margin: 0.35em 0;
      }
      @media print {
        .vine { display: none; }
        .frontispiece { padding: 0.5rem 0; }
        body {
          max-width: none;
          padding: 0;
          background: #fff;
        }
        tbody tr:nth-child(even),
        tr.genitivus {
          background: transparent;
        }
      }
  body
    - format_endings = ->(tabula, desinentiae) { desinentiae.map { |desinentia| tabula.unique?(desinentia) ? "<strong>-#{desinentia}</strong>" : "-#{desinentia}" }.join(" / ") }
    - roman = ->(n) { %w[I II III IV V][n - 1] }
    header.frontispiece
      - %w[vine-left vine-right].each do |side|
        svg.vine class=side viewBox="0 0 110 145" aria-hidden="true" focusable="false"
          path.stem d="M8 137 C23 115 7 94 19 72 S27 33 12 13 C39 8 64 23 97 10 M19 72 C44 68 47 48 39 36 M23 105 C41 99 53 108 50 120 M24 28 C45 31 62 16 77 25"
          path.leaf d="M18 76 C-1 66 4 48 10 45 C10 58 27 57 18 76 Z M39 51 C23 44 27 28 32 26 C33 37 47 37 39 51 Z M57 22 C53 5 70 3 75 6 C64 10 69 23 57 22 Z"
          path.leaf.leaf-red d="M22 96 C43 91 40 76 35 72 C35 85 20 80 22 96 Z M48 113 C61 101 69 113 68 121 C62 114 53 126 48 113 Z M84 16 C81 33 98 34 102 29 C91 29 95 17 84 16 Z"
          circle.berry cx="12" cy="13" r="3"
          circle.berry cx="50" cy="120" r="2.5"
          circle.berry cx="97" cy="10" r="2.5"
      h1
        span.initial D
        | ēclīnātiōnēs Latīnae
    - tabula.numeri.each do |numerus|
        table
          caption= numerus.capitalize
          thead
            tr
              th scope="col"
              - tabula.declinationes.each_with_index do |declinatio, index|
                th scope="colgroup" colspan=3 class=("sep" if index.positive?) = roman.call(declinatio)
            tr
              th scope="col" Cāsus
              - tabula.declinationes.each_with_index do |declinatio, index|
                - tabula.genera.each_with_index do |genus, index_generis|
                  th scope="col" class=("sep" if index_generis.zero? && index.positive?) = "#{genus}."
          tbody
            - tabula.casus.each do |casus|
              tr class="#{casus}"
                th scope="row" = casus.capitalize
                - tabula.declinationes.each_with_index do |declinatio, index|
                  - separatio = ("sep" if index.positive?)
                  - desinentiae = tabula.desinentiae(casus, numerus, declinatio)
                  - if desinentiae.empty?
                    td colspan=3 class=separatio
                    - next
                  - if desinentiae[:mf]
                    - if desinentiae[:mf] == desinentiae[:n]
                      td colspan=3 class=separatio
                        == format_endings.call(tabula, desinentiae[:mf])
                      - next
                    - else
                      td colspan=2 class=separatio
                        == format_endings.call(tabula, desinentiae[:mf])
                  - elsif desinentiae[:f]
                    td class=separatio
                    td
                      == format_endings.call(tabula, desinentiae[:f])
                  - else
                    td colspan=2 class=separatio
                  - if desinentiae[:n]
                    td
                      == format_endings.call(tabula, desinentiae[:n])
                  - else
                    td
    - unless tabula.exceptiones.empty?
      .notae
        ol
          - tabula.exceptiones.each do |nota|
            li= nota
