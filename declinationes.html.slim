doctype html
html
  head
    meta charset="utf-8"
    title Lingua Latina
    css:
      table {
        border-collapse: collapse;
        margin: 25px 0;
        font-size: 0.9em;
        min-width: 400px;
      }
      td {
        padding: 4px;
        border: 1px solid;
      }
      th {
        padding: 4px;
        border: 1px solid;
        min-width: 2em;
      }
      tr.genitivus td {
        color: blue;
      }
      .notae {
        margin-top: 20px;
      }
      .notae ol {
        padding-left: 20px;
      }
      .notae li {
        margin: 4px 0;
      }
  body
    - format_endings = ->(tabula, desinentiae) { desinentiae.map { |desinentia| tabula.unique?(desinentia) ? "<strong>-#{desinentia}</strong>" : "-#{desinentia}" }.join(" / ") }
    h1 Declinationes
    - columnae = tabula.columnae
    - tabula.numeri.each do |numerus|
        table
          thead
              tr: th colspan="#{columnae + 1}" = numerus.capitalize
              tr
                th
                - tabula.declinationes.each do |declinatio|
                  th colspan=3 = declinatio
              tr
                th Casus
                - tabula.declinationes.each do |declinatio|
                  - tabula.genera.each do |genus|
                    th= genus
          tbody
            - tabula.casus.each do |casus|
              tr class="#{casus}"
                th= casus.capitalize
                - tabula.declinationes.each do |declinatio|
                  - desinentiae = tabula.desinentiae(casus, numerus, declinatio)
                  - if desinentiae.empty?
                    td colspan=3
                    - next
                  - if desinentiae[:mf]
                    - if desinentiae[:mf] == desinentiae[:n]
                      td colspan=3
                        == format_endings.call(tabula, desinentiae[:mf])
                      - next
                    - else
                      td colspan=2
                        == format_endings.call(tabula, desinentiae[:mf])
                  - elsif desinentiae[:f]
                    td
                    td
                      == format_endings.call(tabula, desinentiae[:f])
                  - else
                    td colspan=2
                  - if desinentiae[:n]
                    td
                      == format_endings.call(tabula, desinentiae[:n])
                  - else
                    td
  - unless tabula.exceptiones.empty?
    .notae
      ol
        - tabula.exceptiones.each do |nota|
          li= nota
