doctype html
html lang="la"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title Dēclīnātiōnēs Latīnae
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap"
    - if mode == :linked
      link rel="stylesheet" href="#{asset_prefix}/screen.css"
      - if layout == :mobile
        link rel="stylesheet" href="#{asset_prefix}/mobile.css"
      link rel="stylesheet" href="#{asset_prefix}/print.css" media="print"
    - else
      - sheets = [screen_css, (mobile_css if layout == :mobile), print_css].compact
      style
        == sheets.map(&:chomp).join("\n")
  body class=layout.to_s
    - format_endings = ->(_tabula, desinentiae) { desinentiae.map { |desinentia| render_counts[desinentia] == 1 ? "<strong>-#{desinentia}</strong>" : "-#{desinentia}" }.join(" / ") }
    - data_desinentiae = ->(desinentiae) { desinentiae.join(" ") }
    - roman = ->(n) { tabula.numerus_romanus(n) }
    - indicia = { variabilis: ['variável', 'A forma varia conforme o substantivo.'], nominativus: ['= nom.', 'Forma igual à do nominativo do mesmo substantivo e número.'], non_applicatur: [nil, 'Este gênero não ocorre no paradigma regular desta declinação.'], non_representata: ['…', 'Forma não representada nesta tabela.'] }
    - analysis = ->(casus, numerus, declinatio, genera) { cases = layout == :desktop && numerus == :pluralis ? { nominativus: 'nominativus / vocativus', dativus: 'dativus / ablativus' }.fetch(casus, casus.to_s) : casus.to_s; "#{cases} · #{numerus} · decl. #{roman.call(declinatio)} · #{genera}" }
    header.frontispiece
      - %w[vine-left vine-right].each do |side|
        svg.vine class=side viewBox="0 0 110 145" aria-hidden="true" focusable="false"
          path.stem d="M8 137 C23 115 7 94 19 72 S27 33 12 13 C39 8 64 23 97 10 M19 72 C44 68 47 48 39 36 M23 105 C41 99 53 108 50 120 M24 28 C45 31 62 16 77 25"
          path.leaf d="M18 76 C-1 66 4 48 10 45 C10 58 27 57 18 76 Z M39 51 C23 44 27 28 32 26 C33 37 47 37 39 51 Z M57 22 C53 5 70 3 75 6 C64 10 69 23 57 22 Z"
          path.leaf.leaf-red d="M22 96 C43 91 40 76 35 72 C35 85 20 80 22 96 Z M48 113 C61 101 69 113 68 121 C62 114 53 126 48 113 Z M84 16 C81 33 98 34 102 29 C91 29 95 17 84 16 Z"
          circle.berry cx="12" cy="13" r="3"
          circle.berry cx="50" cy="120" r="2.5"
          circle.berry cx="97" cy="10" r="2.5"
      h1
        span.initial D
        | ēclīnātiōnēs Latīnae
    div.versio role="group" aria-label="Forma da página"
      - if layout == :desktop
        span.versio-opcao aria-current="page" Forma plena
        a.versio-opcao href="mobile.html" Forma mobilis
      - else
        a.versio-opcao href="declinationes.html" Forma plena
        span.versio-opcao aria-current="page" Forma mobilis
      button.versio-opcao.versio-print type="button" Forma imprimenda
    - if layout == :mobile
      - tabula.declinationes.each do |declinatio|
        section.paradigma
          h2 = "Declinatio #{roman.call(declinatio)}"
          - tabula.numeri.each do |numerus|
            table
              caption= numerus.capitalize
              thead
                tr
                  th scope="col" Cāsus
                  - tabula.genera.each do |genus|
                    th scope="col" = "#{genus}."
              tbody
                - tabula.casus.each do |casus|
                  - desinentiae = tabula.desinentiae(casus, numerus, declinatio)
                  tr class=casus
                    th scope="row" = casus.capitalize
                    - if desinentiae.empty?
                      td colspan=3
                        - label, explanation = indicia.fetch(tabula.indicium_cellae(casus, numerus, declinatio, :m))
                        - if label
                          span.cell-marker lang="pt-BR" title=explanation aria-label=explanation = label
                    - elsif desinentiae[:mf] && desinentiae[:mf] == desinentiae[:n]
                      td colspan=3 data-desinentiae=data_desinentiae.call(desinentiae[:mf]) data-analysis=analysis.call(casus, numerus, declinatio, 'm. / f. / n.') tabindex="0"
                        == format_endings.call(tabula, desinentiae[:mf])
                    - else
                      - if desinentiae[:mf]
                        td colspan=2 data-desinentiae=data_desinentiae.call(desinentiae[:mf]) data-analysis=analysis.call(casus, numerus, declinatio, 'm. / f.') tabindex="0"
                          == format_endings.call(tabula, desinentiae[:mf])
                      - elsif desinentiae[:f]
                        td
                        td data-desinentiae=data_desinentiae.call(desinentiae[:f]) data-analysis=analysis.call(casus, numerus, declinatio, 'f.') tabindex="0"
                          == format_endings.call(tabula, desinentiae[:f])
                      - else
                        td colspan=2
                          span.cell-marker lang="pt-BR" title="Forma não representada nesta tabela." …
                      - if desinentiae[:n]
                        td data-desinentiae=data_desinentiae.call(desinentiae[:n]) data-analysis=analysis.call(casus, numerus, declinatio, 'n.') tabindex="0"
                          == format_endings.call(tabula, desinentiae[:n])
                      - else
                        td
                          - label, explanation = indicia.fetch(tabula.indicium_cellae(casus, numerus, declinatio, :n))
                          - if label
                            span.cell-marker lang="pt-BR" title=explanation aria-label=explanation = label
    - else
      - tabula.numeri.each do |numerus|
        .tabela
          table
            caption= numerus.capitalize
            thead
              tr
                th scope="col"
                - tabula.declinationes.each_with_index do |declinatio, index|
                  th scope="colgroup" colspan=3 class="sep" = roman.call(declinatio)
              tr
                th scope="col" Cāsus
                - tabula.declinationes.each_with_index do |declinatio, index|
                  - tabula.genera.each_with_index do |genus, index_generis|
                    th scope="col" class=("sep" if index_generis.zero?) = "#{genus}."
            tbody
              - tabula.casus.each do |casus|
                - next if layout == :desktop && numerus == :pluralis && [:vocativus, :ablativus].include?(casus)
                tr class="#{casus}"
                  - if layout == :desktop && numerus == :pluralis && casus == :nominativus
                    th scope="row" Nominativus / Vocativus
                  - elsif layout == :desktop && numerus == :pluralis && casus == :dativus
                    th scope="row" Dativus / Ablativus
                  - else
                    th scope="row" = casus.capitalize
                  - tabula.declinationes.each_with_index do |declinatio, index|
                    - separatio = "sep"
                    - desinentiae = tabula.desinentiae(casus, numerus, declinatio)
                    - if desinentiae.empty?
                      td colspan=3 class=separatio
                        - label, explanation = indicia.fetch(tabula.indicium_cellae(casus, numerus, declinatio, :m))
                        - if label
                          span.cell-marker lang="pt-BR" title=explanation aria-label=explanation = label
                      - next
                    - if desinentiae[:mf]
                      - if desinentiae[:mf] == desinentiae[:n]
                        td colspan=3 class=separatio data-desinentiae=data_desinentiae.call(desinentiae[:mf]) data-analysis=analysis.call(casus, numerus, declinatio, 'm. / f. / n.') tabindex="0"
                          == format_endings.call(tabula, desinentiae[:mf])
                        - next
                      - else
                        td colspan=2 class=separatio data-desinentiae=data_desinentiae.call(desinentiae[:mf]) data-analysis=analysis.call(casus, numerus, declinatio, 'm. / f.') tabindex="0"
                          == format_endings.call(tabula, desinentiae[:mf])
                    - elsif desinentiae[:f]
                      td class=separatio
                      td data-desinentiae=data_desinentiae.call(desinentiae[:f]) data-analysis=analysis.call(casus, numerus, declinatio, 'f.') tabindex="0"
                        == format_endings.call(tabula, desinentiae[:f])
                    - else
                      td colspan=2 class=separatio
                        span.cell-marker lang="pt-BR" title="Forma não representada nesta tabela." …
                    - if desinentiae[:n]
                      td data-desinentiae=data_desinentiae.call(desinentiae[:n]) data-analysis=analysis.call(casus, numerus, declinatio, 'n.') tabindex="0"
                        == format_endings.call(tabula, desinentiae[:n])
                    - else
                      td
                        - label, explanation = indicia.fetch(tabula.indicium_cellae(casus, numerus, declinatio, :n))
                        - if label
                          span.cell-marker lang="pt-BR" title=explanation aria-label=explanation = label
    - unless tabula.notae_per_declinationem.empty?
      .notae
        h2 Notae
        - tabula.notae_per_declinationem.each do |declinatio, notae|
          section.notae-declinatio
            h3 = "Declinatio #{roman.call(declinatio)}"
            ul
              - notae.each do |nota|
                li == nota
    section.legenda lang="pt-BR" aria-labelledby="legenda-titulo"
      h2 id="legenda-titulo" Como ler a tabela
      p
        strong Células sem desinência:
        |  variável = depende do substantivo; = nom. = mesma forma do nominativo; célula em branco = gênero ausente no paradigma regular.
      p
        strong Genitivo em vermelho:
        |  As desinências do genitivo singular distinguem as cinco declinações: I -ae; II -ī; III -is; IV -ūs; V -ēī / -eī. Use essa forma para identificar a declinação do substantivo.
      p
        strong Negrito:
        |  Desinências únicas (com os mesmos mácrons e breves).


      p.interaction-hint Passe o cursor, toque ou use Tab nas terminações para consultar as possibilidades representadas na tabela. A contagem considera cada célula uma vez.
      p.autoria
        ' Extraída do material do
        a href="https://rafaelfalcon.com.br/curso-de-latim-online/" Curso de Latim Online
        '  do professor
        strong Rafael Falcón.
    - if mode == :linked
      script src="#{asset_prefix}/desinentiae.js"
    - else
      script
        == desinentiae_js.chomp
